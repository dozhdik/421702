# Конфигурация МАС управления курсовым проектом
# Скопируйте этот файл в .env и заполните значениями вашего XMPP-сервера.

# XMPP-сервер (Prosody, ejabberd, или публичный тестовый)
XMPP_SERVER=localhost
XMPP_PORT=5222

# Агент-студент
STUDENT_JID=student@localhost
STUDENT_PASS=student123

# Агент-руководитель
SUPERVISOR_JID=supervisor@localhost
SUPERVISOR_PASS=supervisor123

# Агент-координатор
COORDINATOR_JID=coordinator@localhost
COORDINATOR_PASS=coordinator123

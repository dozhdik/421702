="62"/><column index="3" value="46"/><column index="4" value="62"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="SPJ" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="29"/><column index="2" value="29"/><column index="3" value="31"/><column index="4" value="31"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="query_24.sql" filename="C:/3-й курс/ПБЗ/lab1/lab1_2_queries/query_24.sql">-- Reference to file &quot;C:/3-й курс/ПБЗ/lab1/lab1_2_queries/query_24.sql&quot; (not supported by this version) --</sql><sql name="query_19.sql" filename="C:/3-й курс/ПБЗ/lab1/lab1_2_queries/query_19.sql">-- Reference to file &quot;C:/3-й курс/ПБЗ/lab1/lab1_2_queries/query_19.sql&quot; (not supported by this version) --</sql><sql name="query_27.sql" filename="C:/3-й курс/ПБЗ/lab1/lab1_2_queries/query_27.sql">-- Reference to file &quot;C:/3-й курс/ПБЗ/lab1/lab1_2_queries/query_27.sql&quot; (not supported by this version) --</sql><sql name="SQL 4*">SELECT DISTINCT spj.ПР, spj.Д, spj.П
FROM SPJ
JOIN J AS j
ON spj.ПР = j.ПР
JOIN S AS s
ON spj.П = s.П
JOIN P AS p
ON spj.Д = p.Д
WHERE j.Город = s.Город = p.Город</sql><current_tab id="3"/></tab_sql></sqlb_project>

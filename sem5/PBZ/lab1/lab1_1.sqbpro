plot_y_axes/><global_filter/></table><table schema="main" name="ПРЕПОДАВАТЕЛЬ_ПРЕПОДАЕТ_ПРЕДМЕТЫ_В_ГРУППАХ" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="140"/><column index="2" value="153"/><column index="3" value="91"/><column index="4" value="107"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="СТУДЕНЧЕСКАЯ_ГРУППА" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="140"/><column index="2" value="106"/><column index="3" value="124"/><column index="4" value="187"/><column index="5" value="115"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1*">CREATE TABLE ПРЕПОДАВАТЕЛЬ (
    ЛичныйНомер TEXT PRIMARY KEY,
    Фамилия TEXT,
    Должность TEXT,
    Кафедра TEXT,
    Специальность TEXT,
    ТелефонДомашний TEXT
);

CREATE TABLE ПРЕДМЕТ (
    КодовыйНомер TEXT PRIMARY KEY,
    НазваниеПредмета TEXT,
    КоличествоЧасов INTEGER,
    Специальность TEXT,
    Семестр INTEGER
);

CREATE TABLE СТУДЕНЧЕСКАЯ_ГРУППА (
    КодовыйНомерГруппы TEXT PRIMARY KEY,
    НазваниеГруппы TEXT,
    КоличествоЧеловек INTEGER,
    Специальность TEXT,
    ФамилияСтаросты TEXT
);

CREATE TABLE ПРЕПОДАВАТЕЛЬ_ПРЕПОДАЕТ_ПРЕДМЕТЫ_В_ГРУППАХ (
    КодовыйНомерГруппы TEXT,
    КодовыйНомерПредмета TEXT,
    ЛичныйНомер TEXT,
    НомерАудитории INTEGER
);


